#!/usr/bin/make -f
# Debhelper + CMake packaging for AudioScout.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release

override_dh_installdocs:
	dh_installdocs
	# Install the upstream man page (closes lintian no-manual-page).
	install -m 644 -D debian/audioscout.1 debian/audioscout/usr/share/man/man1/audioscout.1
	gzip -9nf debian/audioscout/usr/share/man/man1/audioscout.1

override_dh_missing:
	dh_missing --fail-missing
